<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
  <meiHead>
    <fileDesc>
      <titleStmt><title>Default staff item order</title></titleStmt>
      <pubStmt/>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef meter.count="4" meter.unit="4">
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
              <staffDef n="2" lines="5" clef.shape="F" clef.line="4"/>
            </staffGrp>
          </scoreDef>
          <section>
            <measure n="1">
              <staff n="1">
                <layer n="1"><note xml:id="default-n1" pname="c" oct="4" dur="1"/></layer>
              </staff>
              <staff n="2">
                <layer n="1"><note xml:id="default-n2" pname="c" oct="3" dur="1"/></layer>
              </staff>
              <harm xml:id="default-harm" staff="1" startid="#default-n1" place="between">C major</harm>
              <dynam xml:id="default-dynam" staff="1" startid="#default-n1" place="between">fortissimo</dynam>
              <dir xml:id="default-dir" staff="1" startid="#default-n1" place="between">direction</dir>
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
