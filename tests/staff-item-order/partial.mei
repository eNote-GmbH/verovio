<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
  <meiHead>
    <fileDesc>
      <titleStmt><title>Partial staff item order</title></titleStmt>
      <pubStmt/>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef aboveorder="harm stageDir" meter.count="4" meter.unit="4">
            <staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp>
          </scoreDef>
          <section>
            <measure n="1">
              <staff n="1">
                <layer n="1"><note xml:id="partial-note" pname="c" oct="4" dur="1"/></layer>
              </staff>
              <harm xml:id="partial-harm" staff="1" startid="#partial-note" place="above">C major</harm>
              <stageDir xml:id="partial-stage-dir" staff="1" startid="#partial-note" place="above">stage</stageDir>
              <dynam xml:id="partial-dynam" staff="1" startid="#partial-note" place="above">fortissimo</dynam>
              <dir xml:id="partial-dir" staff="1" startid="#partial-note" place="above">direction</dir>
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
